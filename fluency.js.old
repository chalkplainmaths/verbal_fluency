// init speech recognition
let finished = false;
let recognition;
try {
	recognition = new webkitSpeechRecognition();
} catch(exception) {
	recognition = new SpeechRecognition();
}
recognition.maxAlternatives = 5;
recognition.interimResults = true;
recognition.continuous = false;
recognition.lang = "en-GB";

// add event listeners for speech recog
recognition.addEventListener("result", (event) => {
	if (event.results[0].isFinal) {
		console.log("Final result: " + event.results[0][0].transcript + "\n"
            + "\tat time from start " + (event.timeStamp - start_time) + "\n"
            //+ "\tand time from speech recog start " + (event.timeStamp - speech_start) + "\n"
        );
	} else {
		console.log("Interim result: " + event.results[0][0].transcript + "\n"
			+ "\tat time from start " + (event.timeStamp - start_time) + "\n"
			//+ "\tand time from speech recog start " + (event.timeStamp - speech_start) + "\n"
		);
	}
	//console.log(event);
});
recognition.addEventListener("end", (event) => {
	if (!finished)
		recognition.start();
});
const events = ["audioend", "audiostart", "end", "error", "nomatch", "result", "soundend", "soundstart", "speechend", "speechstart", "start"];
for (let i = 0; i < events.length; ++i) {
	recognition.addEventListener(events[i], (event) => {console.log("EVENT FIRED: " + events[i]);});
}
function start_recognition() {
	return new Promise( (resolve) => {
		recognition.addEventListener("start", () => {
			resolve();
		});
		recognition.start();
	});
}

// declare some variables
// const pavlovia = new Pavlovia();
let participant_id;
let the_data;
let speech_start;
let audio_start;

// main promise chain:
get_submission("Participant ID", true, true)
.then( (value) => {participant_id = value; console.log(participant_id); return wait_button("RECORD");} )
.then( () => {return record_audio(20000);} )
.then( (data) => {finished = true; recognition.stop(); return the_data = data;} )
